# ============================================================
# Kalshi API Configuration
# Create keys at: https://kalshi.com/account/api-keys
# Docs: https://trading-api.kalshi.com/trade-api/v2/openapi.json
# ============================================================
KALSHI_API_KEY=
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Kalshi base URL (use demo for testing)
KALSHI_BASE_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# ============================================================
# Polymarket API Configuration
# Docs: https://docs.polymarket.com
# Gamma API (market metadata): https://gamma-api.polymarket.com
# CLOB API (order books): https://clob.polymarket.com
# Requires a Polygon wallet with EIP-712 signing for authenticated endpoints
# ============================================================
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_WALLET_PRIVATE_KEY=
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# ============================================================
# Database
# ============================================================
DATABASE_URL=./data/arbitrage.db

# ============================================================
# Application Settings (overrides defaults in settings table)
# ============================================================
USE_MOCK_DATA=true
MIN_MATCH_CONFIDENCE=0.80
MIN_ADJUSTED_RETURN=0.00
MAX_SPREAD_ALLOWED=0.10
MIN_LIQUIDITY=100
DEFAULT_SLIPPAGE_BPS=25
# Kalshi charges no trading fee to takers (0 bps)
KALSHI_FEE_BPS=0
# Polymarket charges 2% maker, 2% taker on CLOB (200 bps)
POLYMARKET_FEE_BPS=200
GAS_COST_USD=0.50
CURRENCY_CONVERSION_BPS=0
REFRESH_INTERVAL_SECONDS=60
USE_SEMANTIC_MATCHING=false
MAX_MARKETS_PER_SCAN=500
STALE_DATA_SECONDS=120
MANUAL_REVIEW_THRESHOLD=0.85

# ============================================================
# Misc
# ============================================================
NODE_ENV=development
LOG_LEVEL=info
